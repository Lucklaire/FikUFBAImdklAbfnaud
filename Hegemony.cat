  <sharedProfiles>
    <profile name="Expert Repairer" typeId="7c1a-6666-91ad-1439" typeName="Abilities" hidden="false" id="38eb-2c5f-a06e-542f">
      <characteristics>
        <characteristic name="Description" typeId="1a74-59f3-85ab-ecb7">When this unit is leading a unit with the CYBORG keyword or affects them with an aura ability, said unit&apos;s weapons that have the One Shot keyword may be used as if the keyword was not present.</characteristic>
      </characteristics>
    </profile>
    <profile name="Backline Shooter" typeId="7c1a-6666-91ad-1439" typeName="Abilities" hidden="false" id="38e6-e68e-621e-cdbb">
      <characteristics>
        <characteristic name="Description" typeId="1a74-59f3-85ab-ecb7">This unit gains Benefit of Cover against ranged attacks when within 6&quot; of an allied unit with the CYBORG keyword.</characteristic>
      </characteristics>
    </profile>
    <profile name="Lowlife" typeId="7c1a-6666-91ad-1439" typeName="Abilities" hidden="false" id="73d9-5add-864f-7d85">
      <characteristics>
        <characteristic name="Description" typeId="1a74-59f3-85ab-ecb7">This Strategian may not be your Overlord.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
