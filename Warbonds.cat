        <profile name="Piledriver" typeId="7c1a-6666-91ad-1439" typeName="Abilities" hidden="false" id="f4ff-14d0-011a-cf8d">
          <characteristics>
            <characteristic name="Description" typeId="1a74-59f3-85ab-ecb7">Once per battle, just before shooting, this ability may be used. When used, until the end of the shooting phase, the Corinth LR30 and Helios LR4 gain a +1 to Wound Rolls and any successful wound roll counts as a Critical Wound. Additionally, while this ability is active, the Corinth LR30&apos;s damage attribute is changed to a flat 6.</characteristic>
          </characteristics>
        </profile>
        <profile name="Black Death" typeId="7c1a-6666-91ad-1439" typeName="Abilities" hidden="false" id="c449-2d92-e247-80ea">
          <characteristics>
            <characteristic name="Description" typeId="1a74-59f3-85ab-ecb7">While this model is shooting:
- Enemy units do not have Lone Operative
- Hidden Enemy Units have +15&quot; detection range</characteristic>
          </characteristics>
        </profile>
      </profiles>
