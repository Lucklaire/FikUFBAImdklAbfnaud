                        <characteristic name="Description" typeId="1a74-59f3-85ab-ecb7">Allied units within 8&quot; of this model regenerate 1d3 wounds, or resurrect 1d3 models at 1 wound at the beginning of each command phase after the first.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
