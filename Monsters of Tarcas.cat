        <profile name="Your Body Betrays You (Occult)" typeId="7c1a-6666-91ad-1439" typeName="Abilities" hidden="false" id="1c8e-b450-dbed-4610">
          <characteristics>
            <characteristic name="Description" typeId="1a74-59f3-85ab-ecb7">When an enemy unit is successfully damaged by Your Body Betrays You, roll a d3. Select that many models in the enemy unit. For each model, subtract 1 from their attacks score for all weapons until the start of your next turn (to a minimum of 1).</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
